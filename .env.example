# Diction Masters — copy this to .env and fill it in.
# .env is git-ignored: real keys and passwords never go into the repo.

# ---- how the site runs ----
# development (SQLite, debug pages) or production (PostgreSQL, locked down)
DJANGO_ENV=development
# Leave unset in production. DJANGO_DEBUG=True is only for a laptop.
# DJANGO_DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# Your domains, comma separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins for HTTPS form posts, e.g. https://dictionmasters.com,https://www.dictionmasters.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 0 only while testing a new domain over plain HTTP
# DJANGO_HSTS_SECONDS=31536000
# Force SQLite or PostgreSQL whatever DJANGO_ENV says: sqlite | postgres
# DJANGO_DB=postgres

# ---- PostgreSQL (production) ----
POSTGRES_DB=diction_db
POSTGRES_USER=diction_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# prefer for a database on the same machine, require for a managed one
POSTGRES_SSLMODE=prefer

# ---- Cloudflare R2: every upload and recording ----
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Pronunciation and word look-up ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- Email (password resets, error reports). Left blank: printed to the console ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DJANGO_FROM_EMAIL=Diction Masters <no-reply@example.com>
# Who gets emailed when a page errors, comma separated
DJANGO_ADMIN_EMAILS=
