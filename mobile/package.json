{
  "name": "dictionmasters-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Diction Masters for Android and iPhone (Capacitor app that runs the live Django site with native phone features).",
  "scripts": {
    "setup:android": "cap add android && npm run configure && npm run assets && cap sync android",
    "setup:ios": "cap add ios && npm run configure && npm run assets && cap sync ios",
    "configure": "node scripts/configure-native.mjs",
    "assets": "capacitor-assets generate",
    "sync": "npm run configure && cap sync",
    "release": "cross-env DM_RELEASE=1 npm run sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "check": "node scripts/check.mjs",
    "doctor": "cap doctor",
    "test:sw": "node scripts/test-service-worker.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
